# Copy to .env and adjust. Read by scripts/env.sh (all make targets) and formbench.
# Values already set in your shell take precedence over this file. Never put API keys here
# if the repo is shared: use your shell or .secrets/ (gitignored).

# --- HPC environment modules (leave empty on a laptop) -------------------------------
# Node >= 18 for the Playwright MCP server; Python 3.12 runtime for the vLLM venv.
MODULES="release/25.06 GCCcore/13.3.0 Python/3.12.3 nodejs/20.13.1"

# --- Interpreters (relative paths are relative to the repo root) ---------------------
PYTHON_BIN=.venv/bin/python
VLLM_PYTHON_BIN=.venv-opencua/bin/python

# --- Caches: HF weights/downloads, pip, Playwright browsers. Put this on a large
# workspace filesystem on HPC to avoid /home quota problems.
CACHE_ROOT=.runtime-cache

# --- Data locations (defaults shown) ---------------------------------------------------
# MODELS_CONFIG=configs/models.json
# MODELS_DIR=models
# DATASET_ROOT=data/model_baselines
# REFERENCE_ROOT=data/forms
# LOGS_DIR=logs

# --- LocalForms site -----------------------------------------------------------------
LOCALFORMS_HOST=127.0.0.1
LOCALFORMS_PORT=5000

# --- Slurm (used by `make submit` / SUBMIT=1) -------------------------------------------
SLURM_ACCOUNT=
SLURM_PARTITION=
# Comma-separated nodes to avoid, e.g. a node with a broken GPU.
SLURM_EXCLUDE=
# Extra raw sbatch flags, e.g. "--qos=normal --mail-type=FAIL"
SLURM_EXTRA_ARGS=
# Set LOCAL=1 to run matrix jobs in the current shell even when sbatch exists.
LOCAL=0

# --- API credentials (prefer exporting in your shell) ------------------------------------
# GEMINI_API_KEY_FILE=.secrets/gemini_api_key   # or export GEMINI_API_KEY
# OPENAI_API_KEY=                               # SCADS / OpenAI-compatible APIs
